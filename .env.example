# Use Node.js hosting for the Next.js email endpoint.
SITE_URL=https://www.americanlogoartist.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=American Logo Artist <info@americanlogoartist.com>
CONTACT_TO=info@americanlogoartist.com
# Optional comma-separated additional origins permitted to submit enquiries.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000
# Optional existing integrations. Leave analytics empty for test deployments.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ZENDESK_KEY=d9bf55c7-7b4e-40f2-8fa5-d7ad83b0b767
# Set only for the static review build. Email opens a draft in this mode.
NEXT_PUBLIC_STATIC_PREVIEW=false
